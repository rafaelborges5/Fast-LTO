# Research code. An allowlist, same as the tracks below: the files named here
# are parameterised and run on shipped data; the rest is a local one-off.
research/**/*.py
!research/experiments/skidpad_batch.py
!research/experiments/autox_dfx_grip_sweep.py
!research/experiments/animate_lap.py
!research/experiments/interactive_lap.py

# Track data. An allowlist, so anything dropped into data/tracks/ stays on this
# machine by default -- a boundary CSV off a test day is the team's, not the
# repo's. Shipped: the four public event tracks plus what the generators write.
# Already-tracked files are not governed by this, so removing one also needs
# `git rm --cached`.
data/tracks/*.csv
!data/tracks/fscz_2025.csv
!data/tracks/fscz_2026.csv
!data/tracks/fsg_autox_2025.csv
!data/tracks/fsg_autox_2026.csv
!data/tracks/ellipse.csv
!data/tracks/bean.csv
!data/tracks/fsg_random.csv

